<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationId>net.syphon.smoke</ApplicationId>
    <RunWithOpen>false</RunWithOpen>
    <PublishAot>true</PublishAot>
    <!-- A smoke run needs no debug symbols bundle. -->
    <NoDSymUtil>true</NoDSymUtil>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A native executable ships no XML docs; this project's only feed IDE0005. The Compile-only AOT
         publish (dotnet/sdk#54515) also never copies them into OutDir, where publish looks (MSB3030). -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>
</Project>
