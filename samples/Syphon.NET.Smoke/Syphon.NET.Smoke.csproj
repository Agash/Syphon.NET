<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationId>net.syphon.smoke</ApplicationId>
    <RunWithOpen>false</RunWithOpen>
    <PublishAot>true</PublishAot>
    <!-- A smoke run needs no debug symbols bundle. -->
    <NoDSymUtil>true</NoDSymUtil>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML file only feeds the analyzers; a native executable ships without it, and the SDK's
         AOT publish looks for it where it never copies it (MSB3030 with SDK 11 rc.2). -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>
</Project>
