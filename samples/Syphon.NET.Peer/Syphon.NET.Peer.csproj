<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1515: a sample's types do not need to be internal. CA1303: console diagnostics are not localized. -->
    <NoWarn>CA1515;CA1050;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>

  <!-- Copy the native shim next to the output so [LibraryImport] resolves it on macOS. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\build\libsyphon_shim.dylib')">
    <None Include="..\..\native\build\libsyphon_shim.dylib"
          CopyToOutputDirectory="PreserveNewest">
      <Link>libsyphon_shim.dylib</Link>
    </None>
    <None Include="..\..\native\build\default.metallib"
          CopyToOutputDirectory="PreserveNewest">
      <Link>default.metallib</Link>
    </None>
  </ItemGroup>
</Project>
