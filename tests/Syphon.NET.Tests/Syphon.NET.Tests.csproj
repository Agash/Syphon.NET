<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The library binds Microsoft's macOS frameworks (IOSurface/CoreVideo/Metal), so it is
         macOS-only; tests share that target. -->
    <TargetFramework>net11.0-macos</TargetFramework>
    <!-- A test module on this target is an app: the SDK builds it into a .app bundle and points the
         run command at the apphost inside it. That bundle is only emitted for a RID-specific build,
         and Release otherwise defaults to a universal build with no single RID, which left the run
         command with an empty RID segment (bin/Release/net11.0-macos//...) pointing at a bundle
         that was never built - reported as a launch failure and zero tests. Pinning the host RID
         keeps the path real on both arm64 and Intel machines. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>net.syphon.tests</ApplicationId>
    <IsPackable>false</IsPackable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <!-- Entry-point generation stays off (the Apple SDK's default): Main.cs starts AppKit before
         handing over to the runner, which the IOSurface and directory tests need. Extension
         registration is still generated, so Main.cs names no extension itself. -->
    <!-- Launching via `open` goes through LaunchServices, which neither propagates the parent's
         environment nor reliably forwards arguments, so the runner never completes its handshake
         with `dotnet test`. Launch the app binary directly instead. -->
    <RunWithOpen>false</RunWithOpen>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1515: test types do not need to be internal -->
    <NoWarn>CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native shim flows in transitively from the Syphon.NET project reference (it is copied to
         output there); no need to re-declare it here. -->
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>
</Project>
