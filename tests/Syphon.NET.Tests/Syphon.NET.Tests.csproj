<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The library binds Microsoft's macOS frameworks (IOSurface/CoreVideo/Metal), so it is
         macOS-only; tests share that target. -->
    <TargetFramework>net11.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>net.syphon.tests</ApplicationId>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Deliberately not on the Microsoft.Testing.Platform runner, unlike every other repo here.
         A net11.0-macos test project builds into a .app bundle, and MTP tries to launch an
         executable inside it that a plain build does not produce, so the run reports zero tests.
         That also rules out MTP's --coverage, which is why this repo reports no coverage. -->
    <!-- CA1515: test types do not need to be internal -->
    <NoWarn>CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native shim flows in transitively from the Syphon.NET project reference (it is copied to
         output there); no need to re-declare it here. -->
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>
</Project>
