<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The library binds Microsoft's macOS frameworks (IOSurface/CoreVideo/Metal), so it is
         macOS-only; tests share that target. -->
    <TargetFramework>net11.0-macos</TargetFramework>
    <!-- The test runner is the test module's own entry point, so this is an app like any other
         -macos Exe: the SDK builds it into a .app bundle and points RunCommand at the apphost
         inside it. That bundle is only emitted for a RID-specific build. Without candidate RIDs
         declared here the slnx-level restore emits no RID asset target, the bundle is never built,
         and RunCommand resolves to an empty RID segment (bin/Release/net11.0-macos//...) that does
         not exist - which the platform reports as a launch failure and zero tests. Listing both
         keeps arm64 and Intel hosts working; the samples project does the same for the same reason. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>net.syphon.tests</ApplicationId>
    <IsPackable>false</IsPackable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <!-- The Apple SDK turns entry-point generation off, because an app on this target is normally
         expected to hand-write Main and start NSApplication. A test module has no UI and the runner
         is its entry point, so opt back in: the platform only defaults this property, an explicit
         value wins, and the generated Main registers the runner and every extension hook. Without
         it the module compiles to an Exe with no Main at all. -->
    <GenerateTestingPlatformEntryPoint>true</GenerateTestingPlatformEntryPoint>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1515: test types do not need to be internal -->
    <NoWarn>CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native shim flows in transitively from the Syphon.NET project reference (it is copied to
         output there); no need to re-declare it here. -->
    <ProjectReference Include="..\..\src\Syphon.NET\Syphon.NET.csproj" />
  </ItemGroup>
</Project>
