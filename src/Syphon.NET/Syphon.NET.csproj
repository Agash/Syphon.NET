<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Syphon.NET</RootNamespace>
    <!-- The shipped library runs the recommended rule set as errors; tests stay on the default set. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Syphon.NET</PackageId>
    <Description>Syphon for .NET: share video frames between macOS applications in real time as IOSurfaces, compatible with OBS, Resolume, MadMapper, TouchDesigner and every other Syphon application. A managed implementation of the Syphon protocol on .NET for macOS, with no native library to ship. Native AOT compatible.</Description>
    <PackageTags>syphon;macos;gpu;texture;sharing;iosurface;metal;obs;video;capture;interop;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="Syphon.NET.Tests" />
  </ItemGroup>
</Project>
